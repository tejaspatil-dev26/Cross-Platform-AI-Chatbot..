# AI Provider options: ollama, gemini, mock
AI_PROVIDER=ollama

# Ollama settings (used when AI_PROVIDER=ollama)
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# CPU Acceleration Configuration (High Performance CPU Settings)
# Set FORCE_CPU=true and OLLAMA_NUM_GPU=0 to run completely on CPU without GPU
FORCE_CPU=true
OLLAMA_NUM_GPU=0
OLLAMA_NUM_THREAD=8
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=60m
EMBEDDING_DEVICE=cpu
OLLAMA_TIMEOUT=120.0

# Gemini settings (used when AI_PROVIDER=gemini) - Cloud AI (0% local GPU/CPU load, instant sub-second answers)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# RAG Configuration
RAG_ENABLED=true
CHROMA_PERSIST_PATH=./app/db/chroma
UPLOAD_DIR=./uploaded_files
MAX_FILE_SIZE_MB=50
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=3
